
# Локальный адрес веб-интерфейса (в production укажите HTTPS origin).
PUBLIC_ORIGIN=http://localhost:8080
DOMAIN=localhost

# Секрет для обмена между backend, ML-service и Docker runner.
# Замените перед запуском: длинная случайная строка (например, 64 hex-символа).
ML_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Пароль PostgreSQL. Для существующей БД не меняйте без процедуры смены пароля.
# Это пример для локальной установки, не используйте его в открытом интернете.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# Генерация тестов и AI Bug Detective через Yandex AI Studio.
AI_PROVIDER=yandex
OPENAI_API_KEY=REPLACE_WITH_YANDEX_API_KEY
OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Подставьте ID своего каталога Yandex Cloud вместо YOUR_FOLDER_ID.
OPENAI_MODEL=gpt://YOUR_FOLDER_ID/deepseek-v4-flash

# Семантический поиск: отдельные Yandex Embeddings, без второго ключа.
# Backend использует OPENAI_API_KEY, если AI_PROVIDER совпадает с EMBEDDING_PROVIDER.
EMBEDDING_PROVIDER=yandex
YANDEX_FOLDER_ID=YOUR_FOLDER_ID
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ai.api.cloud.yandex.net/foundationModels/v1
EMBEDDING_MODEL=emb://YOUR_FOLDER_ID/text-search-doc/latest
EMBEDDING_QUERY_MODEL=emb://YOUR_FOLDER_ID/text-search-query/latest
# Пустое значение = определить размерность по фактическому ответу (обычно 256).
EMBEDDING_DIMENSIONS=

